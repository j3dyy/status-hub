{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "StatusPageData",
  "type": "object",
  "required": ["system", "providers", "categories", "incidents"],
  "properties": {
    "system": {
      "type": "object",
      "required": ["name", "status", "lastUpdated"],
      "properties": {
        "name": { "type": "string" },
        "tagline": { "type": "string" },
        "company": { "type": "string" },
        "url": { "type": "string", "format": "uri" },
        "status": {
          "type": "string",
          "enum": ["operational", "degraded", "partial_outage", "major_outage", "maintenance"]
        },
        "statusMessage": { "type": "string" },
        "lastUpdated": { "type": "string", "format": "date-time" },
        "refreshIntervalSeconds": { "type": "integer", "minimum": 5 }
      }
    },
    "providers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name"],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "url": { "type": "string" },
          "icon": { "type": "string" },
          "status": {
            "type": "string",
            "enum": ["operational", "degraded", "partial_outage", "major_outage", "maintenance"]
          }
        }
      }
    },
    "categories": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "services"],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "description": { "type": "string" },
          "services": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["id", "name", "status"],
              "properties": {
                "id": { "type": "string" },
                "providerId": { "type": "string" },
                "name": { "type": "string" },
                "description": { "type": "string" },
                "status": {
                  "type": "string",
                  "enum": ["operational", "degraded", "partial_outage", "major_outage", "maintenance"]
                },
                "uptime90d": { "type": "number", "minimum": 0, "maximum": 100 },
                "currentLatencyMs": { "type": "number" },
                "components": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": ["id", "name", "status"],
                    "properties": {
                      "id": { "type": "string" },
                      "name": { "type": "string" },
                      "status": {
                        "type": "string",
                        "enum": ["operational", "degraded", "partial_outage", "major_outage", "maintenance"]
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "incidents": {
      "type": "object",
      "required": ["active", "past"],
      "properties": {
        "active": { "type": "array" },
        "past": { "type": "array" }
      }
    }
  }
}
